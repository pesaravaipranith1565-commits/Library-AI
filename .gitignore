# =============================================================================
#  Library AI Agent — .gitignore
#  Files listed here are NEVER committed to GitHub.
#  Private credentials, local databases, build artefacts, dependencies.
# =============================================================================


# -----------------------------------------------------------------------------
# PRIVATE CREDENTIALS — NEVER COMMIT THESE
# -----------------------------------------------------------------------------

# Backend .env file — contains IBM Cloud API key, watsonx Project ID, JWT secret
backend/.env

# Streamlit secrets — contains IBM Cloud API key, watsonx Project ID
streamlit_app/.streamlit/secrets.toml

# Any .env variants across the project
.env
.env.local
.env.development
.env.production
.env.staging
.env.test
**/.env
**/.env.local
**/.env.*.local


# -----------------------------------------------------------------------------
# DATABASE / RUNTIME DATA — local only, not for version control
# -----------------------------------------------------------------------------

# LowDB flat-file database (backend runtime data)
backend/src/data/db.json

# Streamlit flat-file database (runtime data)
streamlit_app/data/db.json

# SQLite databases
*.sqlite
*.sqlite3
*.db


# -----------------------------------------------------------------------------
# NODE.JS / NPM
# -----------------------------------------------------------------------------

node_modules/
backend/node_modules/
frontend/node_modules/
frontend/build/
frontend/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz


# -----------------------------------------------------------------------------
# PYTHON / STREAMLIT
# -----------------------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
venv/
.venv/
env/
ENV/
streamlit_app/venv/
streamlit_app/.venv/
*.egg-info/
dist/
build/
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/
.mypy_cache/
.pyright/
.ruff_cache/
.ipynb_checkpoints/


# -----------------------------------------------------------------------------
# OPERATING SYSTEM
# -----------------------------------------------------------------------------

.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*~


# -----------------------------------------------------------------------------
# EDITOR / IDE
# -----------------------------------------------------------------------------

.vscode/
.idea/
*.iml
*.iws
*.ipr
*.sublime-project
*.sublime-workspace
*.swp
*.swo


# -----------------------------------------------------------------------------
# LOGS AND TEMP
# -----------------------------------------------------------------------------

logs/
*.log
*.log.*
pids/
*.pid
*.seed
.tmp/
tmp/
temp/


# =============================================================================
# WHAT IS SAFE TO COMMIT (kept in repo)
# =============================================================================
# backend/.env.example       -- template with placeholder values only (NO real keys)
# backend/src/**             -- all application source code
# frontend/src/**            -- all React source code
# frontend/public/**         -- static assets
# frontend/package.json      -- dependency manifest
# streamlit_app/app.py       -- Streamlit entry point
# streamlit_app/pages/**     -- all Streamlit pages
# streamlit_app/services/**  -- Python service modules
# streamlit_app/requirements.txt
# streamlit_app/.streamlit/config.toml   -- UI theme only (no credentials)
# README.md                  -- project documentation
# =============================================================================