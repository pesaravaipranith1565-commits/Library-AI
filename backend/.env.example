# ─── Server Configuration ────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Frontend URL (for CORS) ─────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── JWT Secret (for future auth) ────────────────────────────
